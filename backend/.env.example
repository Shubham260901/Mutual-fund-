# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Sign-in email for the admin panel at /admin (required). "Forgot password" links are sent here.
ADMIN_EMAIL=

# Password for the admin panel (required). Use a long, unique one.
# A new password set through "Forgot password" replaces it until you change this value again,
# so editing ADMIN_PASSWORD here is also the way back in if you lose access to the email.
ADMIN_PASSWORD=

# Public address of the site, used in password reset links (default http://localhost:5173).
# The "Website address" saved in the admin Settings takes priority once set.
# PUBLIC_URL=https://www.example.com

# Signs admin session cookies. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random one is used and admins are signed out on every server restart.
SESSION_SECRET=

# API server port (default 3001).
PORT=3001

# Where the SQLite database and uploaded gallery photos live (default ./data). Use a persistent disk in production.
# DATA_DIR=data

# Number of reverse proxies in front of the server (Render, Railway, Nginx, Cloudflare: usually 1).
# Needed so rate limiting sees real visitor IPs and admin cookies are marked Secure over HTTPS.
# TRUST_PROXY=1

# Optional email via Resend (https://resend.com): an alert for every new enquiry and password reset links.
# Without it, reset links are printed in the API server's console (development only).
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=you@example.com
# ENQUIRY_FROM_EMAIL=Website Enquiries <enquiries@yourdomain.com>

# Built frontend served by this server in production (default ../frontend/dist).
# FRONTEND_DIST=../frontend/dist
